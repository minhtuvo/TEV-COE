rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - role: string (required, 'admin' or 'customer')
    //   - customerId: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: customers
    // Document ID: {customerId}
    // Fields:
    //   - name: string (required)
    //   - createdAt: string (required)
    //
    // Collection: equipment
    // Document ID: {equipmentId}
    // Fields:
    //   - name: string (required)
    //   - customerId: string (required)
    //   - customerName: string (optional)
    //   - location: string (optional)
    //   - status: string (optional)
    //   - lastInspection: string (optional)
    //   - nextInspection: string (optional)
    //   - manufacturer: string (optional)
    //   - year: number (optional)
    //   - power: string (optional)
    //   - voltage: string (optional)
    //   - type: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: dgaReports
    // Document ID: {reportId}
    // Fields:
    //   - equipmentId: string (required)
    //   - customerId: string (required)
    //   - date: string (required)
    //   - inspector: string (optional)
    //   - status: string (optional)
    //   - notes: string (optional)
    //   - h2, ch4, c2h6, c2h4, c2h2, co, co2, moisture, acidity, bdStrength, ffa, estDp, age, loadFactor, currentHealthScore, futureHealthScore: number (optional)
    //   - currentHI, futureHI, tdcgCondition: string (optional)
    //   - recommendations: list (optional)
    //   - createdAt: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "sgm1707@gmail.com")
      );
    }

    function getUserCustomerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId;
    }

    function isCustomerOwner(customerId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserCustomerId() == customerId
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['email', 'role', 'createdAt']) &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.role in ['admin', 'customer'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('customerId' in data) || (data.customerId is string && data.customerId.size() < 100)) &&
             data.createdAt is string;
    }

    function isValidCustomer(data) {
      return hasRequiredFields(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.createdAt is string &&
             (!('factories' in data) || (data.factories is list)) &&
             (!('email' in data) || (data.email is string)) &&
             (!('phone' in data) || (data.phone is string)) &&
             (!('address' in data) || (data.address is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    function isValidEquipment(data) {
      return hasRequiredFields(['name', 'customerId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.customerId is string && data.customerId.size() > 0 && data.customerId.size() < 100 &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() < 200)) &&
             (!('location' in data) || (data.location is string && data.location.size() < 500)) &&
             (!('status' in data) || (data.status in ['healthy', 'warning', 'critical'])) &&
             (!('lastInspection' in data) || (data.lastInspection is string && data.lastInspection.size() < 100)) &&
             (!('nextInspection' in data) || (data.nextInspection is string && data.nextInspection.size() < 100)) &&
             (!('manufacturer' in data) || (data.manufacturer is string && data.manufacturer.size() < 200)) &&
             (!('year' in data) || data.year is number) &&
             (!('power' in data) || (data.power is string && data.power.size() < 100)) &&
             (!('voltage' in data) || (data.voltage is string && data.voltage.size() < 100)) &&
             (!('type' in data) || (data.type is string && data.type.size() < 100)) &&
             data.createdAt is string;
    }

    function isValidDgaReport(data) {
      return hasRequiredFields(['equipmentId', 'customerId', 'date', 'createdAt']) &&
             data.equipmentId is string && data.equipmentId.size() > 0 && data.equipmentId.size() < 100 &&
             data.customerId is string && data.customerId.size() > 0 && data.customerId.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             (!('inspector' in data) || (data.inspector is string && data.inspector.size() < 100)) &&
             (!('status' in data) || (data.status in ['healthy', 'warning', 'critical'])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 2000)) &&
             (!('h2' in data) || data.h2 is number) &&
             (!('ch4' in data) || data.ch4 is number) &&
             (!('c2h6' in data) || data.c2h6 is number) &&
             (!('c2h4' in data) || data.c2h4 is number) &&
             (!('c2h2' in data) || data.c2h2 is number) &&
             (!('co' in data) || data.co is number) &&
             (!('co2' in data) || data.co2 is number) &&
             (!('moisture' in data) || data.moisture is number) &&
             (!('acidity' in data) || data.acidity is number) &&
             (!('bdStrength' in data) || data.bdStrength is number) &&
             (!('ffa' in data) || data.ffa is number) &&
             (!('estDp' in data) || data.estDp is number) &&
             (!('age' in data) || data.age is number) &&
             (!('loadFactor' in data) || data.loadFactor is number) &&
             (!('currentHealthScore' in data) || data.currentHealthScore is number) &&
             (!('futureHealthScore' in data) || data.futureHealthScore is number) &&
             (!('currentHI' in data) || (data.currentHI is string && data.currentHI.size() < 10)) &&
             (!('futureHI' in data) || (data.futureHI is string && data.futureHI.size() < 10)) &&
             (!('tdcgCondition' in data) || (data.tdcgCondition is string && data.tdcgCondition.size() < 100)) &&
             (!('recommendations' in data) || (data.recommendations is list && data.recommendations.size() < 20)) &&
             data.createdAt is string;
    }

    function isValidWorkOrder(data) {
      return hasRequiredFields(['title', 'equipmentId', 'customerId', 'status', 'priority', 'type', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             (data.equipmentId is string || data.equipmentId is list) &&
             data.customerId is string && data.customerId.size() > 0 && data.customerId.size() < 100 &&
             data.status in ["initiated", "approved", "planned", "scheduled", "in-progress", "completed", "cancelled", "overdue"] &&
             data.priority in ['low', 'medium', 'high', 'urgent'] &&
             data.type in ["preventive", "corrective", "inspection", "emergency", "unplanned"] &&
             (!('assignedTo' in data) || (data.assignedTo is string && data.assignedTo.size() < 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() < 2000)) &&
             (!('attachments' in data) || (data.attachments is list && data.attachments.size() < 20)) &&
             (!('usedMaterials' in data) || (data.usedMaterials is list && data.usedMaterials.size() < 50)) &&
             (!('responsibleApprove' in data) || (data.responsibleApprove is string)) &&
             (!('responsibleDo' in data) || (data.responsibleDo is string)) &&
             (!('workPermitId' in data) || (data.workPermitId is string)) &&
             (!('blockingRequired' in data) || (data.blockingRequired is bool)) &&
             (!('isUnplanned' in data) || (data.isUnplanned is bool)) &&
             (!('failureCode' in data) || (data.failureCode is string)) &&
             (!('pmFrequency' in data) || (data.pmFrequency is string)) &&
             (!('estimatedTime' in data) || (data.estimatedTime is number)) &&
             (!('laborCount' in data) || (data.laborCount is number)) &&
             (!('laborCost' in data) || (data.laborCost is number)) &&
             (!('partCost' in data) || (data.partCost is number)) &&
             data.createdAt is string;
    }

    function isValidInventoryItem(data) {
      return hasRequiredFields(['name', 'sku', 'quantity', 'unit', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() < 100 &&
             data.quantity is number &&
             data.unit is string && data.unit.size() > 0 && data.unit.size() < 50 &&
             (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
             (!('minStock' in data) || data.minStock is number) &&
             (!('location' in data) || (data.location is string && data.location.size() < 200)) &&
             (!('price' in data) || data.price is number) &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (
        isAdmin() || (isOwner(userId) && request.resource.data.role == 'customer')
      );
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (
        isAdmin() || (isOwner(userId) && areImmutableFieldsUnchanged(['role', 'customerId', 'createdAt']))
      );
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || isCustomerOwner(customerId);
      allow create: if isAdmin() && isValidCustomer(request.resource.data);
      allow update: if isAdmin() && isValidCustomer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /equipment/{equipmentId} {
      allow read: if isAdmin() || isCustomerOwner(resource.data.customerId);
      allow create: if isAdmin() && isValidEquipment(request.resource.data);
      allow update: if isAdmin() && isValidEquipment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /dgaReports/{reportId} {
      allow read: if isAdmin() || isCustomerOwner(resource.data.customerId);
      allow create: if isAdmin() && isValidDgaReport(request.resource.data);
      allow update: if isAdmin() && isValidDgaReport(request.resource.data);
      allow delete: if isAdmin();
    }

    match /workOrders/{orderId} {
      allow read: if isAdmin() || isCustomerOwner(resource.data.customerId);
      allow create: if isAdmin() && isValidWorkOrder(request.resource.data);
      allow update: if isAuthenticated() && isValidWorkOrder(request.resource.data) && (
        isAdmin() || (isCustomerOwner(resource.data.customerId) && areImmutableFieldsUnchanged(['createdAt', 'equipmentId', 'customerId']))
      );
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidInventoryItem(request.resource.data);
      allow update: if isAuthenticated() && isValidInventoryItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /_connection_test_/ping {
      allow read: if true;
    }
  }
}
