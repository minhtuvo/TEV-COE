{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application, either an admin/staff or a customer.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "description": "User's full name"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "customer"],
          "description": "Role of the user. Admins can see everything, customers can only see their own data."
        },
        "customerId": {
          "type": "string",
          "description": "Reference to the Customer entity if the user is a customer. Empty for admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Represents a customer company/factory.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the customer company"
        },
        "factories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of factories associated with this customer"
        },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "createdAt"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Represents a transformer asset.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the transformer"
        },
        "customerId": {
          "type": "string",
          "description": "ID of the customer who owns this equipment"
        },
        "customerName": {
          "type": "string",
          "description": "Name of the customer (denormalized for easy display)"
        },
        "location": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "warning", "critical"]
        },
        "lastInspection": {
          "type": "string"
        },
        "nextInspection": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "year": {
          "type": "number"
        },
        "power": {
          "type": "string"
        },
        "voltage": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "customerId", "createdAt"]
    },
    "DgaReport": {
      "title": "DgaReport",
      "description": "Represents a DGA analysis report for a specific equipment.",
      "type": "object",
      "properties": {
        "equipmentId": {
          "type": "string"
        },
        "customerId": {
          "type": "string",
          "description": "ID of the customer who owns the equipment (for security rules)"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "inspector": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["healthy", "warning", "critical"]
        },
        "notes": {
          "type": "string"
        },
        "h2": { "type": "number" },
        "ch4": { "type": "number" },
        "c2h6": { "type": "number" },
        "c2h4": { "type": "number" },
        "c2h2": { "type": "number" },
        "co": { "type": "number" },
        "co2": { "type": "number" },
        "moisture": { "type": "number" },
        "acidity": { "type": "number" },
        "bdStrength": { "type": "number" },
        "ffa": { "type": "number" },
        "estDp": { "type": "number" },
        "age": { "type": "number" },
        "loadFactor": { "type": "number" },
        "currentHealthScore": { "type": "number" },
        "futureHealthScore": { "type": "number" },
        "currentHI": { "type": "string" },
        "futureHI": { "type": "string" },
        "tdcgCondition": { "type": "string" },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["equipmentId", "customerId", "date", "createdAt"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Represents a maintenance work order for an asset.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "equipmentId": { "type": "string" },
        "customerId": { "type": "string" },
        "factory": { "type": "string" },
        "assignedTo": { "type": "string", "description": "User ID of the assigned technician" },
        "status": {
          "type": "string",
          "enum": ["initiated", "approved", "planned", "scheduled", "in-progress", "completed", "cancelled", "overdue"]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"]
        },
        "type": {
          "type": "string",
          "enum": ["preventive", "corrective", "inspection", "emergency", "unplanned"]
        },
        "responsibleApprove": { "type": "string", "description": "Role required to approve current phase" },
        "responsibleDo": { "type": "string", "description": "Role required to perform current phase" },
        "workPermitId": { "type": "string" },
        "blockingRequired": { "type": "boolean" },
        "isUnplanned": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "usedMaterials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "equipmentId", "customerId", "status", "priority", "type", "createdAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Represents a spare part or material in the warehouse.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "price": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sku", "quantity", "unit", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles."
    },
    "customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Stores customer companies."
    },
    "equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Stores transformer assets."
    },
    "dgaReports/{reportId}": {
      "schema": { "$ref": "#/entities/DgaReport" },
      "description": "Stores DGA analysis reports."
    },
    "workOrders/{orderId}": {
      "schema": { "$ref": "#/entities/WorkOrder" },
      "description": "Stores maintenance work orders."
    },
    "inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Stores inventory items and spare parts."
    }
  }
}
